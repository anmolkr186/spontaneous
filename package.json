{
  "name": "spontaneous",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "pretauri": "bash scripts/use-external-target.sh",
    "tauri": "tauri",
    "pretauri:dev": "bash scripts/use-external-target.sh",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "package": "bash scripts/package-macos.sh",
    "typecheck": "tsc -b --noEmit",
    "preversion": "test \"$(git branch --show-current)\" = main && npm run typecheck",
    "version": "node scripts/sync-version.mjs && git add Cargo.toml Cargo.lock",
    "postversion": "git push --follow-tags"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.32",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^1.65.0",
    "motion": "^14.8.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
